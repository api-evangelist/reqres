{
  "$schema": "https://json-structure.org/meta/core/v0/#",
  "$id": "https://raw.githubusercontent.com/api-evangelist/reqres/refs/heads/main/json-structure/reqres-agent-money-structure.json",
  "name": "AgentMoney",
  "description": "AgentMoney schema from ReqRes API",
  "type": "object",
  "properties": {
    "amount": {
      "type": "int32",
      "description": "Value in smallest currency unit (cents for USD, pence for GBP)."
    },
    "currency": {
      "type": "string",
      "description": "ISO 4217 code, e.g. USD."
    },
    "formatted": {
      "type": "string",
      "description": "Human-readable display string with currency symbol."
    }
  },
  "required": [
    "amount",
    "currency",
    "formatted"
  ]
}