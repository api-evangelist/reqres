      "name": "Agent Sandbox",
      "description": {
        "content": "Endpoints designed for AI coding agents. Cursor pagination, deeply nested resources, deliberate error scenarios, deterministic seeded fixtures.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "cfb61d3e-9db8-4243-ab44-7633429ed6a6",
          "name": "ReqRes Agent Sandbox Health Probe",
          "request": {
            "name": "ReqRes Agent Sandbox Health Probe",
            "description": {
              "content": "Lightweight health check that returns sandbox status, version, uptime, and the caller's current rate-limit status. Cached at the edge for 10 seconds. Cheap to poll. Send the optional x-agent-id header to elevate to Agent Developer tier limits.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "agent",
                "v1",
                "health"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
